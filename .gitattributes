# Keep documentation screenshots in LFS.  The browser face-detection assets
# below must remain ordinary Git files: Vercel does not resolve LFS pointers
# when serving Vite's public directory.
docs/screenshots/*.png filter=lfs diff=lfs merge=lfs -text
*.wasm filter=lfs diff=lfs merge=lfs -text
*.tflite filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text

# Exclude public assets from LFS so Vercel can serve them directly
frontend/public/*.png -filter -merge -diff -text
frontend/public/*.ico -filter -merge -diff -text
